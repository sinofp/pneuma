#!/usr/bin/env expect

set timeout 120

proc must {pattern} {
    expect {
        -exact $pattern {}
        timeout { puts "\nsmoke: TIMEOUT waiting for \"$pattern\""; exit 1 }
        eof { puts "\nsmoke: unexpected EOF waiting for \"$pattern\""; exit 1 }
    }
}

set has_gpu [expr {"--gpu" in $argv}]
set is_smp [expr {"--smp" in $argv}]

spawn ./run {*}$argv

# Kernel boot lines print before user procs run, so they arrive unmangled.
must "Process created: libc-test (5)"
must "Process created: a (6)"
must "Process created: b (7)"
must "Process created: shell (8)"
if {$has_gpu} {
    must "Process created: doom (9)"
}

if {$is_smp} {
    # --smp 5: boot lottery picks one primary (random id); the other 4 harts
    # come up as secondaries. Count them id-agnostically.
    for {set i 0} {$i < 4} {incr i} {
        expect {
            -re {hart [0-9]+ up} {}
            timeout { puts "\nsmoke: TIMEOUT waiting for secondary harts"; exit 1 }
            eof     { puts "\nsmoke: EOF waiting for secondary harts"; exit 1 }
        }
    }
}

# DOOM or proc-a&b
if {$has_gpu} {
    must "I_InitGraphics: Auto-scaling factor: "
} else {
    if {!$is_smp} {
        # It's hard to get unmangled proc-a output on SMP
        must "proc-a: reply from pid 7: OK"
    }
    # Kernel always hold console lock, so it's fine to match this after proc-a&b finishes
    must "process 6 exited"
}

# Shell tests
send "\r"
must "> "

send "hello\r"
must "Hello world from shell!"
must "> "

send "cat\r"
must "filename> "
send "hello.txt\r"
must "Hello from FAT filesystem!"
must "> "

# C-a x quits QEMU's -nographic mux
send "\x01x"
expect eof
puts "smoke: OK"
