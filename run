#!/usr/bin/env zsh

# Build and run RISC-V OS kernel with optional debugging support

set -ue

# Architecture selection (default: rv32)
# Usage: ./run [rv32|rv64] [--debug] [--gdb] [--uboot]
local arch=rv32
local debug=false
local use_gdb=false
local use_uboot=false

# Parse arguments
while (( $# > 0 )) {
    case $1 {
        (rv32)
            arch=rv32
            shift
            ;;
        (rv64)
            arch=rv64
            shift
            ;;
        (--debug)
            debug=true
            shift
            ;;
        (--gdb)
            use_gdb=true
            shift
            ;;
        (--uboot)
            use_uboot=true
            shift
            ;;
        (*)
            echo "Error: Unknown argument '$1'"
            echo "Usage: $0 [rv32|rv64] [--debug] [--gdb] [--uboot]"
            exit 1
            ;;
    }
}

# Architecture-specific configuration
local qemu abi
case $arch {
    (rv32)
        qemu=qemu-system-riscv32
        abi=ilp32
        ;;
    (rv64)
        qemu=qemu-system-riscv64
        abi=lp64
        ;;
}

echo "Building for ${arch:u}..."

# OpenSBI firmware path
local opensbi_fw=$QEMU_OPENSBI/share/opensbi/$abi/generic/firmware/fw_dynamic.bin

# Build kernel for selected architecture
nix build --no-substitute .#$arch -o result-$arch

local kernel_elf=result-$arch/kernel.elf
local shell_elf=result-$arch/shell.elf
local user_a_elf=result-$arch/user-a.elf
local user_b_elf=result-$arch/user-b.elf

# U-Boot is only available for RV64
if [[ $use_uboot == true && $arch != rv64 ]] {
    echo "Error: U-Boot boot is only supported for rv64"
    exit 1
}

# Check if U-Boot binary exists
if [[ $use_uboot == true && ! -f $UBOOT_QEMU ]] {
    echo "Error: U-Boot binary not found at $UBOOT_QEMU"
    echo "Make sure you're running inside 'nix develop'"
    exit 1
}

# Prepare boot configuration
local qemu_kernel
if [[ $use_uboot == true ]] {
    echo "Boot chain: OpenSBI (M-mode) → U-Boot (S-mode) → Kernel (S-mode)"
    qemu_kernel=$UBOOT_QEMU
} else {
    qemu_kernel=$kernel_elf
}

pushd disk
tar cf ../disk.tar --format=ustar *.txt
popd

if [[ $debug == true ]] {
    echo "Starting QEMU (${arch:u}) with GDB server on port 1234"

    # Get the compilation directory from debug info for source mapping
    local kernel_comp_dir=$(llvm-dwarfdump $kernel_elf | grep DW_AT_comp_dir | head -1 | sed -E 's|.*"(.*)".*|\1|')

    # Start QEMU in background with debugger support
    $qemu -machine virt -bios $opensbi_fw -nographic -serial mon:stdio \
          --no-reboot -kernel $qemu_kernel \
	  -drive id=drive0,file=disk.tar,format=raw,if=none \
          -device virtio-blk-device,drive=drive0,bus=virtio-mmio-bus.0 \
          -s -S &

    local qemu_pid=$!

    # Split wezterm pane and start debugger in the new bottom pane
    if [[ $use_gdb == true ]] {
        echo 'Splitting terminal and starting GDB...'
        echo "Source mapping: $kernel_comp_dir -> $PWD"
        wezterm cli split-pane --bottom --percent 62 -- zsh -c "
            gdb-dashboard $kernel_elf \
              -ex 'set confirm off' \
              -ex 'set substitute-path $kernel_comp_dir "$PWD"' \
              -ex 'add-symbol-file $shell_elf' \
              -ex 'add-symbol-file $user_a_elf' \
              -ex 'add-symbol-file $user_b_elf' \
              -ex 'target remote localhost:1234'
        " >/dev/null # Ignores pane-id because it'll be closed when exiting GDB
    } else {
        echo 'Splitting terminal and starting LLDB...'
        echo "Source mapping: $kernel_comp_dir -> $PWD"
        wezterm cli split-pane --bottom --percent 62 -- zsh -c "
            lldb $kernel_elf \
              -o 'settings set target.source-map $kernel_comp_dir "$PWD"' \
              -o 'image add $shell_elf' \
              -o 'image add $user_a_elf' \
              -o 'image add $user_b_elf' \
              -o 'gdb-remote localhost:1234'
        " >/dev/null # Ignores pane-id because it'll be closed when exiting LLDB
    }

    # Wait for QEMU to finish
    wait $qemu_pid 2>/dev/null || true

} else {
    # Start QEMU normally
    if [[ $use_uboot == true ]] {
        echo "Running ${arch:u} via U-Boot..."
    } else {
        echo "Running ${arch:u} kernel..."
    }
    $qemu -machine virt -bios $opensbi_fw -nographic -serial mon:stdio \
          --no-reboot -kernel $qemu_kernel \
          -d unimp,guest_errors,int,cpu_reset -D qemu-$arch.log \
	  -drive id=drive0,file=disk.tar,format=raw,if=none \
          -device virtio-blk-device,drive=drive0,bus=virtio-mmio-bus.0
}
