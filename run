#!/usr/bin/env zsh

# Build and run RISC-V OS kernel with optional debugging support

set -ue

# Architecture selection (default: rv32)
# Usage: ./run [rv32|rv64|vf2|board] [--debug] [--gdb] [--uboot] [--dts] [--gpu] [--smp N] [--no-virtio]
local model=rv32
local debug=false
local use_gdb=false
local use_uboot=false
local use_dts=false
local use_gpu=false
local no_virtio=false
local smp=1
local smp_set=false

# Parse arguments
while (( $# > 0 )) {
    case $1 {
        (rv32)
            model=rv32
            shift
            ;;
        (rv64)
            model=rv64
            shift
            ;;
        (vf2)
            model=vf2
            shift
            ;;
        (board)
            model=board
            shift
            ;;
        (--debug)
            debug=true
            shift
            ;;
        (--gdb)
            use_gdb=true
            shift
            ;;
        (--uboot)
            use_uboot=true
            shift
            ;;
        (--dts)
            use_dts=true
            shift
            ;;
        (--gpu)
            use_gpu=true
            shift
            ;;
        (--smp)
            smp=$2
            smp_set=true
            shift 2
            ;;
        (--no-virtio)
            no_virtio=true
            shift
            ;;
        (*)
            print "Error: Unknown argument '$1'"
            print "Usage: $0 [rv32|rv64|vf2|board] [--debug] [--gdb] [--uboot] [--dts] [--gpu] [--smp N] [--no-virtio]"
            exit 1
            ;;
    }
}

# Architecture-specific configuration
local qemu abi
case $model {
    (rv32)
        qemu=qemu-system-riscv32
        abi=ilp32
        arch=rv32
        ;;
    (rv64|vf2|board)
        qemu=qemu-system-riscv64
        abi=lp64
        arch=rv64
        ;;
}

# The jh7110 SoC is fixed 1×S7 + 4×U74; the machine's min_cpus is 2, so the
# rv32/rv64 default of 1 would be rejected. Default vf2 to the full 5 harts
# unless the user asked for a specific --smp.
if [[ $model == vf2 && $smp_set == false ]] {
    smp=5
}

# gdb can't attach on jh7110: it takes the ABI from hart 0 (the FPU-less S7,
# flen 0) but the kernel is lp64d (flen 8), so riscv_gdbarch_init errors out at
# connect ("bfd requires flen 8, but target has flen 0").
if [[ $model == vf2 && $use_gdb == true ]] {
    print "Error: gdb can't attach on vf2 -- the jh7110 hart 0 (S7) has no FPU,"
    print "so gdb rejects the flen mismatch with the lp64d kernel at connect."
    print "Use lldb instead: ./run vf2 --debug (without --gdb)."
    exit 1
}

print "Building for ${model:u}..."

# OpenSBI firmware path
local opensbi_fw=$QEMU_OPENSBI/share/opensbi/$abi/generic/firmware/fw_dynamic.bin

# Build kernel for selected architecture
# nix build --no-substitute .#$arch -o result-$arch
nix build .#$arch -o result-$arch

local kernel_elf=result-$arch/kernel.elf
local kernel_img=result-${arch}/Image
local shell_elf=result-$arch/shell.elf
local a_elf=result-$arch/a.elf
local b_elf=result-$arch/b.elf

if [[ $model == board ]] {
    print "Flashing the VF2 Lite over UART + USB fastboot..."
    print "Power on / reset the board now; waiting for U-Boot autoboot on /dev/ttyACM0..."
    ./uboot.exp --board /dev/ttyACM0 115200 $kernel_img
    exit
}

# U-Boot is only available for RV64
if [[ $use_uboot == true && $model != rv64 ]] {
    print "Error: U-Boot boot is only supported for rv64"
    exit 1
}

# --no-virtio mimics the real VF2 Lite while U-Boot boot needs its 
# boot disk and --gpu needs the virtio-gpu, so both conflict.
if [[ $no_virtio == true && ( $use_uboot == true || $use_gpu == true ) ]] {
    print "Error: --no-virtio conflicts with --uboot and --gpu"
    exit 1
}

# Check if U-Boot binary exists
if [[ $use_uboot == true && ! -f $UBOOT_QEMU ]] {
    print "Error: U-Boot binary not found at $UBOOT_QEMU"
    print "Make sure you're running inside 'nix develop'"
    exit 1
}

# Prepare boot configuration
local qemu_kernel
if [[ $use_uboot == true ]] {
    print "Boot chain: OpenSBI (M-mode) → U-Boot (S-mode) → Kernel (S-mode)"
    qemu_kernel=$UBOOT_QEMU
} elif [[ $arch == rv64 ]] {
    # The rv64 kernel is a static-PIE linked at 0x80200000. Feeding QEMU the ELF
    # would pin it to that p_paddr — fine on virt (DRAM 0x80000000), but off the
    # end of jh7110's DRAM (0x40000000). The flat Image carries no address, so
    # QEMU loads it at the machine's boot address and the kernel self-relocates:
    # a no-op on virt (0x80200000) and a -0x40000000 slide on jh7110 (0x40200000).
    # One artifact boots both rv64 machines; rv32 (ET_EXEC, no reloc) uses its ELF.
    qemu_kernel=$kernel_img
} else {
    qemu_kernel=$kernel_elf
}

local machine_name=virt
[[ $model == vf2 ]] && machine_name=jh7110
local qemu_machine=$machine_name

# virt always runs with svade=on: QEMU's walker updates A/D bits in hardware
# by default, silently forgiving PTEs with A/D clear.
# sstc=off avoids a QEMU stall seen with svade=on + Sstc and matches the U74.
# vf2 needs no override: the jh7110 machine keeps the real sifive CPU models
# and forces ext_svade on its harts itself (patches/qemu-jh7110.patch).
local cpu_args=""
if [[ $model != vf2 ]] {
    cpu_args="-cpu $model,svade=on,sstc=off"
}
if [[ $use_dts == true && $use_uboot == false ]] {
    qemu_machine="${machine_name},dumpdtb=${machine_name}-${model}.dtb"
}

# Assign virtio-mmio bus slots in order of device registration
local virtio_bus=0
local data_disk_args="" keyboard_args="" boot_disk_args="" gpu_args=""

if [[ $no_virtio == false ]] {
    # Use FAT disk image from build output (copy to writable location)
    local disk_img=disk-$model.img
    cp result-$arch/disk.img $disk_img
    chmod +w $disk_img

    # Inject any local files from disk/ that aren't tracked by git (e.g. large game assets)
    for f in disk/*(.); {
        mcopy -i $disk_img -o $f ::${f:t}
    }

    data_disk_args="-drive id=drive0,file=$disk_img,format=raw,if=none \
      -device virtio-blk-device,drive=drive0,bus=virtio-mmio-bus.$((virtio_bus++))"

    keyboard_args="-device virtio-keyboard-device,bus=virtio-mmio-bus.$((virtio_bus++))"
}

# Create boot disk for U-Boot if needed
if [[ $use_uboot == true ]] {
    local boot_img=boot-${model}.img
    print "Creating boot disk image: $boot_img"

    # Create disk image and format as FAT32 (whole-disk, no partition table)
    dd if=/dev/zero of=$boot_img bs=1M count=16 2>/dev/null
    mkfs.vfat -F 32 $boot_img >/dev/null

    # Copy Image to boot disk
    mcopy -i $boot_img $kernel_img ::Image

    # U-Boot enumerates virtio-blk devices in reverse MMIO address order,
    # so registering the boot disk last makes it appear as virtio 0 to U-Boot
    boot_disk_args="-drive id=boot,file=$boot_img,format=raw,if=none \
      -device virtio-blk-device,drive=boot,bus=virtio-mmio-bus.$((virtio_bus++))"
}

if [[ $use_gpu == true ]] {
    gpu_args="-device virtio-gpu-device,bus=virtio-mmio-bus.$((virtio_bus++))"
    if [[ $OSTYPE == darwin* ]] {
        gpu_args+=" -display cocoa,zoom-to-fit=on"
    }
}

local nographic_arg="--no-reboot -nographic -serial mon:stdio"
if [[ $use_gpu == true ]] {
    nographic_arg="--no-reboot -serial mon:stdio"
}

local qemu_common_args="-machine $qemu_machine -smp $smp $cpu_args \
      -bios $opensbi_fw -kernel $qemu_kernel \
      $nographic_arg \
      $data_disk_args $keyboard_args \
      $boot_disk_args $gpu_args"

if [[ $use_dts == true && $use_uboot == true ]] {
    local uboot_dts=dts/virt-${model}-uboot.dts
    rm -f $uboot_dts
    {
        print -r -- 'fdt addr $fdtcontroladdr' # Let U-Boot expand it, not ZSH
        print -r -- "fdt print"
        print -r -- "reset"
    } | $qemu ${(z)qemu_common_args} 2>&1 \
        | awk '/fdt print/{found=1;next} found && /reset/{exit} found{print}' \
	> $uboot_dts
    print "Wrote $uboot_dts"
    exit
}

if [[ $use_dts == true && $use_uboot == false ]] {
    local dts=dts/${machine_name}-${model}.dts
    rm -f $dts
    $qemu ${(z)qemu_common_args} >/dev/null 2>&1 || true
    dtc -I dtb -O dts -o $dts ${machine_name}-${model}.dtb
    rm -f ${machine_name}-${model}.dtb
    print "Wrote $dts"
    exit
}

if [[ $use_uboot == true && $debug == false ]] {
    print "Running ${model:u} via OpenSBI + U-Boot..."

    # TODO Running expect catches C-a prefix for QEMU
    ./uboot.exp $qemu ${(z)qemu_common_args} -d unimp,guest_errors,int,cpu_reset -D qemu-$model.log

} elif [[ $debug == true ]] {
    print "Starting QEMU (${model:u}) with GDB server on port 1234"

    # Get the compilation directory from debug info for source mapping
    local kernel_comp_dir=$(llvm-dwarfdump $kernel_elf | grep DW_AT_comp_dir | head -1 | sed -E 's|.*"(.*)".*|\1|')

    # Kill any lingering QEMU holding port 1234
    lsof -ti:1234 | xargs kill 2>/dev/null || true

    # Start QEMU in background with debugger support
    $qemu ${(z)qemu_common_args} -s -S &

    local qemu_pid=$!

    # On vf2 the flat Image self-relocates from the 0x80200000 link base down to
    # jh7110's 0x40200000 DRAM, so kernel.elf's symbols sit 0x40000000 too high.
    # Slide them to track the running code (virt loads at the link base — no slide).
    # Only lldb reaches here: --gdb is rejected on vf2 (hart 0 has no FPU). lldb
    # parses --slide as unsigned (rejects -0x...) and matches --file by basename,
    # so pass the two's-complement wrap (0x80200000 + it = 0x40200000) and ${kernel_elf:t}.
    local reloc_lldb=""
    if [[ $model == vf2 ]] {
        reloc_lldb="-o 'target modules load --file ${kernel_elf:t} --slide 0xffffffffc0000000'"
    }

    # Prepare debugger command
    local debugger_cmd
    local debugger_name
    if [[ $use_gdb == true ]] {
        debugger_name="GDB"
        debugger_cmd="
            gdb-dashboard $kernel_elf \
                -ex 'set confirm off' \
                -ex 'set substitute-path $kernel_comp_dir "$PWD"' \
                -ex 'add-symbol-file $shell_elf' \
                -ex 'add-symbol-file $a_elf' \
                -ex 'add-symbol-file $b_elf' \
                -ex 'target remote localhost:1234'
        "
    } else {
        debugger_name="LLDB"
        debugger_cmd="
            lldb $kernel_elf \
                -o 'settings set target.source-map $kernel_comp_dir "$PWD"' \
                $reloc_lldb \
                -o 'image add $shell_elf' \
                -o 'image add $a_elf' \
                -o 'image add $b_elf' \
                -o 'gdb-remote localhost:1234'
        "
    }

    print "Source mapping: $kernel_comp_dir -> $PWD"

    # Split pane and start debugger
    print "Splitting terminal and starting $debugger_name..."
    ~/dotfiles/bin/term/split --down --percent 62 --command "$debugger_cmd"

    # Wait for QEMU to finish
    wait $qemu_pid 2>/dev/null || true

} else {
    # Start QEMU normally
    if [[ $use_uboot == true ]] {
        print "Running ${model:u} via U-Boot..."
    } else {
        print "Running ${model:u} kernel..."
    }
    $qemu ${(z)qemu_common_args} -d unimp,guest_errors,int,cpu_reset -D qemu-$model.log
}
