#!/usr/bin/env zsh
# Emit an assembly stub that embeds a flat binary as
# _binary_<sym>_bin_{start,size} (the same symbols objcopy -O binary would create
# from a named .o, but decoupled from the input filename).
#
#   gen-incbin.sh <sym> <abs-path-to.bin> [section]   > out.S
#
# <sym> must already have '-' rewritten to '_' by the caller.

set -ue
local sym=$1
local bin=$2
local section=${3:-.rodata}
cat <<EOF
.section ${section}
.global _binary_${sym}_bin_start
.global _binary_${sym}_bin_size
.balign 8
_binary_${sym}_bin_start:
.incbin "${bin}"
.set _binary_${sym}_bin_size, . - _binary_${sym}_bin_start
EOF
