#!/usr/bin/env zsh
# Build the 32MB FAT16 data disk seeded from a directory.
#
#   mkdisk.sh <out.img> <seed-dir>
#
# 32MB is deliberate: virtio-blk.cc picks the *largest* virtio-blk device as the
# data disk, so this image must stay bigger than the kernel image (and the
# U-Boot boot disk) to be selected.
set -ue
local out=$1
local seed=$2

dd if=/dev/zero of=$out bs=1M count=32 status=none
mkfs.fat -F 16 $out >/dev/null
local f
for f in $seed/*(.); {
    mcopy -i $out $f "::${f:t}"
}
