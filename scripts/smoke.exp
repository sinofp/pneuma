#!/usr/bin/env expect

set timeout 180

set repo_root [file dirname [file dirname [file normalize [info script]]]]

proc must {pattern} {
    expect {
        -exact $pattern {}
        timeout { puts "\nsmoke: TIMEOUT waiting for \"$pattern\""; exit 1 }
        eof { puts "\nsmoke: unexpected EOF waiting for \"$pattern\""; exit 1 }
    }
}

set has_gpu [expr {"--gpu" in $argv}]
set is_vf2 [expr {"vf2" in $argv}]

# Mirror ./scripts/run's -smp default: 1 for virt, 5 for the jh7110 (fixed 1×S7 + 4×U74).
set smp 1
set smp_idx [lsearch -exact $argv "--smp"]
if {$smp_idx >= 0} {
    set smp [lindex $argv [expr {$smp_idx + 1}]]
} elseif {$is_vf2} {
    set smp 5
}
set is_smp [expr {$smp > 1}]

# Secondaries = all harts minus the boot-lottery winner; on the jh7110 hart 0
# (the MMU-less S7) is reported not-startable and never comes up.
set ups [expr {$smp - 1 - $is_vf2}]

spawn $repo_root/scripts/run {*}$argv

# Kernel boot lines print before user procs run, so they arrive unmangled.
must "Process created: libc-test (5)"
must "Process created: a (6)"
must "Process created: b (7)"
must "Process created: shell (8)"
if {$has_gpu} {
    must "Process created: doom (9)"
}

if {$is_smp} {
    if {$is_vf2} {
        must "hart 0 not startable"
    }
    # Boot lottery picks one primary (random id); the remaining startable harts
    # come up as secondaries. Count them id-agnostically.
    for {set i 0} {$i < $ups} {incr i} {
        expect {
            -re {hart [0-9]+ up} {}
            timeout { puts "\nsmoke: TIMEOUT waiting for secondary harts"; exit 1 }
            eof     { puts "\nsmoke: EOF waiting for secondary harts"; exit 1 }
        }
    }
}

# DOOM or proc-a&b
if {$has_gpu} {
    must "I_InitGraphics: Auto-scaling factor: "
} else {
    if {!$is_smp} {
        # It's hard to get unmangled proc-a output on SMP
        must "proc-a: reply from pid 7: OK"
    }
    # Kernel always hold console lock, so it's fine to match this after proc-a&b finishes
    must "process 6 exited"
}

# Shell tests
send "\r"
must "> "

send "hello\r"
must "Hello world from shell!"
must "> "

send "cat\r"
must "filename> "
send "hello.txt\r"
must "Hello from FAT filesystem!"
must "> "

# C-a x quits QEMU's -nographic mux
send "\x01x"
expect eof
puts "smoke: OK"
