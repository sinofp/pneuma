#!/usr/bin/env zsh

# Run smoke.exp across every supported arch/flag combination and print a pass/fail summary.

set -u

local repo_root=${0:A:h:h}

local -a bases=(rv32 rv64 "rv64 --uboot")
local -a configs=(vf2)
local base gpu smp
for base in $bases; {
    for gpu in "" "--gpu"; {
        for smp in "" "--smp 5"; {
            configs+=("${base}${gpu:+ $gpu}${smp:+ $smp}")
        }
    }
}

local -a passed failed
local cfg
for cfg in $configs; {
    print -n "matrix: ${(r:30:)cfg}"
    if { $repo_root/scripts/smoke.exp ${(z)cfg} >/dev/null 2>&1 } {
        print "PASS"
        passed+=$cfg
    } else {
        print "FAIL"
        failed+=$cfg
    }
}

print "\nmatrix: ${#passed}/${#configs} passed"
if (( ${#failed} )) {
    print "matrix: FAILED configs:"
    print -l -- "  - "${^failed}
    exit 1
}
print "matrix: OK"
