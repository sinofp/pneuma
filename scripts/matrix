#!/usr/bin/env zsh

# Run smoke.exp across every supported arch/flag combination and print a pass/fail summary.

set -u

local repo_root=${0:A:h:h}

local -a configs=()

local -a extras=("" --gpu --no-virtio)

local base smp extra
for base (rv32 rv64 "rv64 --uboot") {
    for smp ("" "--smp 5") {
        for extra ("${extras[@]}") {
            if [[ $base == *--uboot* && $extra == --no-virtio ]] { continue }
            configs+=("${base}${smp:+ $smp}${extra:+ $extra}")
        }
    }
}

for extra ("${extras[@]}") {
    configs+=("vf2${extra:+ $extra}")
}

configs=(${(uo)configs})

mkdir -p $repo_root/logs

local -a passed failed
local cfg
for cfg ($configs) {
    print -n "matrix: ${(r:30:)cfg}"
    $repo_root/scripts/smoke.exp ${(z)cfg} 2>&1 | tr -d '\r' >$repo_root/logs/$cfg.log
    if (( 0 == pipestatus[1] )) {
        print "PASS"
        passed+=$cfg
    } else {
        print "FAIL"
        failed+=$cfg
    }
}

print "\nmatrix: ${#passed}/${#configs} passed"
if (( ${#failed} )) {
    print "matrix: FAILED configs:"
    print -l -- "  - "${^failed}
    exit 1
}
print "matrix: OK"
