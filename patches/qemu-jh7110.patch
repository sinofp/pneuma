diff --git a/include/hw/riscv/jh7110.h b/include/hw/riscv/jh7110.h
new file mode 100644
index 0000000000..dba7b648c2
--- /dev/null
+++ b/include/hw/riscv/jh7110.h
@@ -0,0 +1,41 @@
+/*
+ * StarFive JH7110 SoC machine interface (VisionFive 2 Lite twin)
+ *
+ * See hw/riscv/jh7110.c for the machine model.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_RISCV_JH7110_H
+#define HW_RISCV_JH7110_H
+
+#include "hw/boards.h"
+#include "hw/riscv/riscv_hart.h"
+#include "hw/sysbus.h"
+
+#define JH7110_CPUS_MAX 5
+
+#define TYPE_JH7110_MACHINE MACHINE_TYPE_NAME("jh7110")
+typedef struct JH7110State JH7110State;
+DECLARE_INSTANCE_CHECKER(JH7110State, JH7110_MACHINE, TYPE_JH7110_MACHINE)
+
+struct JH7110State {
+    /*< private >*/
+    MachineState parent;
+
